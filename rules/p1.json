{
  "schema_version": "1.0.0",
  "id": "P1",
  "name": "均线排列原则",
  "category": "technical",
  "scope": "使用日K线审核的上市股票",
  "rule_type": "required_with_preferences",
  "data": {
    "frequency": "daily",
    "price_field": "close",
    "as_of": "审核日最近一个已收盘交易日",
    "intraday_final_judgement_allowed": false,
    "minimum_history_requirement": "至少120个交易日",
    "moving_average_periods": [5, 10, 20, 60],
    "preferred_source": "东方财富日K收盘价"
  },
  "metrics": {
    "MA5": "SMA(close, 5)",
    "MA10": "SMA(close, 10)",
    "MA20": "SMA(close, 20)",
    "MA60": "SMA(close, 60)",
    "core_ma_mean": "(MA5 + MA10 + MA20) / 3",
    "core_ma_range": "max(MA5, MA10, MA20) - min(MA5, MA10, MA20)",
    "core_relative_range_pct": "core_ma_range / core_ma_mean * 100",
    "slope_10_pct_per_day": "(MA_t / MA_t_minus_10 - 1) / 10 * 100"
  },
  "state_definitions": {
    "core_upward": {
      "all": [
        "MA10 > MA20",
        "S10_MA5 > 0",
        "S10_MA10 > 0",
        "S10_MA20 > 0"
      ]
    },
    "core_bullish_alignment": {
      "all": [
        "MA5 > MA10",
        "MA10 > MA20",
        "S10_MA5 > 0",
        "S10_MA10 > 0",
        "S10_MA20 > 0"
      ]
    },
    "core_bearish": {
      "any": [
        "S10_MA5 < 0 and S10_MA10 < 0 and S10_MA20 < 0",
        "MA10 <= MA20"
      ]
    },
    "dense": {
      "threshold_pct": 2.0,
      "condition": "core_relative_range_pct <= 2.0"
    }
  },
  "evaluation": [
    {
      "state": "core_direction",
      "required_conditions": [
        {
          "id": "core_upward",
          "expression": "S10_MA5 > 0 and S10_MA10 > 0 and S10_MA20 > 0 and MA10 > MA20"
        }
      ],
      "preferences": [
        {
          "id": "core_bullish_alignment",
          "expression": "MA5 > MA10 > MA20"
        }
      ],
      "decision": {
        "required_failed": "fail",
        "required_passed_and_any_preference_failed": "conditional_pass",
        "all_passed": "pass"
      }
    }
  ],
  "insufficient_information_conditions": [
    "历史数据不足以计算要求的均线与10日斜率",
    "计算周期无法核对"
  ],
  "required_disclosures": [
    "data_as_of_date",
    "close",
    "MA5",
    "MA10",
    "MA20",
    "MA60",
    "S10_MA5",
    "S10_MA10",
    "S10_MA20",
    "S10_MA60",
    "core_ma_mean",
    "core_ma_range",
    "core_relative_range_pct",
    "technical_state",
    "condition_results",
    "result",
    "reason"
  ],
  "exceptions": []
}
